# Normalise line endings so a repo authored on Windows still builds on Linux.
* text=auto eol=lf

# These MUST be LF regardless of platform. A shell script checked out with CRLF
# fails at the shebang with "bad interpreter: /usr/bin/env sh^M", and the same
# applies to anything a Linux container executes or parses.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
docker-entrypoint.sh text eol=lf

# Windows-only scripts keep CRLF.
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Binary — never touch, never diff.
*.png           binary
*.jpg           binary
*.pdf           binary
*.joblib        binary
*.safetensors   binary
*.bin           binary

# Notebooks: keep them diffable but do not let git rewrite their JSON.
*.ipynb         text eol=lf
