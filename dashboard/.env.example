# ---------------------------------------------------------------------------
# Dashboard configuration (optional)
#
# By default the dashboard calls the API through same-origin relative paths:
# Vite proxies them in development, nginx proxies them in production. That
# needs no configuration and involves no CORS.
#
# Set these only when the API is served from a different origin — for example
# the dashboard on Vercel and the API on Render.
# ---------------------------------------------------------------------------

# Absolute base URL of the API. Leave empty for same-origin.
# VITE_API_BASE=https://pulseai-api.onrender.com

# Only needed if the API was deployed with API_KEY set.
# VITE_API_KEY=
