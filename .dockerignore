# Keep the build context small and the image free of local state.
.git
.github
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.ipynb_checkpoints

# Secrets and local config never enter an image.
.env
.env.local

# Regenerated by src/dataset.py - not needed at runtime.
data/

# Large and irrelevant to the API image.
notebooks/
dashboard/
tests/
docs/
scripts/
reports/logs/
reports/figures/

*.md
!models/README.md
