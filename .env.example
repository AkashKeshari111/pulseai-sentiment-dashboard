# ---------------------------------------------------------------------------
# PulseAI environment configuration
# Copy this file to `.env` and fill in your own values.
#   PowerShell:  Copy-Item .env.example .env
# ---------------------------------------------------------------------------

# --- MongoDB Atlas -----------------------------------------------------------
# Create a FREE M0 cluster at https://cloud.mongodb.com, then:
#   Database Access -> add a user  |  Network Access -> allow 0.0.0.0/0
#   Connect -> Drivers -> copy the "mongodb+srv://" string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=pulseai

# --- Model -------------------------------------------------------------------
# Path to the fine-tuned DistilBERT directory produced by src/train_transformer.py
MODEL_DIR=models/distilbert-sentiment
# Fallback used when MODEL_DIR does not exist yet (downloaded from the Hub)
FALLBACK_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
MAX_SEQ_LENGTH=256
DEVICE=auto

# --- API ---------------------------------------------------------------------
API_HOST=0.0.0.0
# 8000 is a very common default and is often already taken by another project
# on the same machine, so this ships on 8020. Change it here and the dashboard's
# dev proxy follows automatically - nothing else needs editing.
API_PORT=8020
# Comma-separated list of allowed browser origins for the dashboard
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: set a value to require the `X-API-Key` header on write endpoints.
# Leave blank to disable authentication (fine for local demos).
API_KEY=

# --- Training ----------------------------------------------------------------
DATASET=yelp_review_full
TRAIN_SIZE=12000
VAL_SIZE=2000
TEST_SIZE=2000
EPOCHS=2
BATCH_SIZE=16
LEARNING_RATE=3e-5
SEED=42
